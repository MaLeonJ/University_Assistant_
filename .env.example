# Copia este archivo a .env y rellena los valores.

# --- Obligatorias ---
TELEGRAM_TOKEN=
AI_PROVIDER=gemini            # gemini | openrouter
AI_API_KEY=                   # clave del proveedor elegido
AUTHORIZED_USER_ID=           # tu ID de Telegram (@userinfobot)

# --- IA (opcionales) ---
# AI_MODEL=                    # default por proveedor si se omite
# AI_FALLBACK_MODELS=modelo1,modelo2
# AI_DAILY_LIMIT=100

# --- Rutas (opcionales; relativas = relativas al proyecto) ---
# OUTPUT_DIR=documentos
# OBSIDIAN_DIR=~/GoogleDrive/Obsidian/Notebook/Universidad
# DATA_DIR=data
# LOG_DIR=logs

# --- Búsqueda web ---
# SEARCH_MAX_RESULTS=5
# CACHE_TTL_DAYS=7

# --- Google Drive (opcional; botón ☁️ Drive) ---
# ID de la carpeta destino: la parte final de su URL en Drive.
# GDRIVE_FOLDER_ID=
# GDRIVE_CREDENTIALS_FILE=credentials.json
# GDRIVE_TOKEN_FILE=data/token.json
